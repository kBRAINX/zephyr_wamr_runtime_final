# Kconfig — options specifiques a l'application WAMR multi-transport
#
# Declare les symboles personnalises utilises dans prj.conf et les overlays
# de configuration. Sans ce fichier, Zephyr rejette CONFIG_WAMR_* comme
# "unknown symbol".

mainmenu "WAMR multi-transport metrics runtime"

config WAMR_NODE_DEVICE_NAME
	string "Nom unique de l'equipement (expose au module WASM)"
	default "zephyr_node"
	help
	  Identifiant du noeud, transmis au module WASM a l'execution via la
	  host function host_get_device_name. Jamais code en dur dans le .wasm.

config WAMR_NODE_DEVICE_TYPE
	string "Type / famille de l'equipement"
	default "generic"
	help
	  Categorie materielle informative (ex. esp32s3, esp32c6, stm32wb55).
	  Exposee via host_get_device_type.

config WAMR_NODE_OS_NAME
	string "Nom de l'OS hote"
	default "zephyr"
	help
	  Expose via host_get_os_name.

# --- Tailles memoire WAMR, ajustables par carte ---
# Permettent d'adapter l'empreinte a chaque equipement. Les cartes a large
# RAM (ESP32-S3, ESP32-C6) gardent les valeurs par defaut ; les cartes
# contraintes (NUCLEO-WB55RG, ~192 Ko de RAM) les reduisent dans leur
# fichier boards/<carte>.conf, sinon l'edition de liens deborde.

config WAMR_APP_POOL_SIZE_KB
	int "Taille du pool memoire WAMR (Ko)"
	default 160
	help
	  Doit contenir la memoire lineaire du module (64 Ko incompressibles)
	  plus les metadonnees WAMR. Minimum realiste : ~72 Ko.

config WAMR_APP_WASM_MAX_KB
	int "Taille max du binaire .wasm accepte (Ko)"
	default 40

config WAMR_APP_STACK_KB
	int "Taille de pile d'execution WAMR (Ko)"
	default 8

config WAMR_APP_HEAP_KB
	int "Taille du tas d'application WAMR (Ko)"
	default 16

config WAMR_WIFI_SSID
	string "SSID du point d'acces Wi-Fi"
	default "a26nguep-hotspot"
	depends on WIFI
	help
	  Utilise uniquement par le backend transport Wi-Fi. Sans effet en BLE.

config WAMR_WIFI_PSK
	string "Mot de passe Wi-Fi (PSK)"
	default "123456789"
	depends on WIFI
	help
	  Utilise uniquement par le backend transport Wi-Fi. Sans effet en BLE.

# Rattachement a l'arbre Kconfig de Zephyr (obligatoire).
source "Kconfig.zephyr"
